{
  "name": "cco-security-suite",
  "productName": "CCO Security Suite",
  "version": "1.2.0",
  "description": "Central de Controle Operacional - Plataforma Integrada de Inteligência de Segurança",
  "author": {
    "name": "TecPrimus Soluções Tecnológicas",
    "email": "tecprimus2021@outlook.com"
  },
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean:dist": "node scripts/clean-dist.cjs",
    "clean:data": "node scripts/reset-database.cjs",
    "generate:icon": "electron scripts/generate-icon.cjs",
    "generate:docs-pdf": "electron scripts/generate-pdf-docs.cjs",
    "build:pdf": "electron scripts/build-manual-pdf.cjs",
    "prebuild:exe": "npm run clean:dist && npm run clean:data && npm run generate:icon",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:3000 && electron . --dev\"",
    "electron:start": "electron .",
    "build:exe": "npm run clean:dist && npm run clean:data && npm run generate:icon && vite build && electron-builder --win nsis",
    "build:portable": "npm run clean:dist && npm run clean:data && npm run generate:icon && vite build && electron-builder --win portable",
    "build:all": "npm run clean:dist && npm run clean:data && npm run generate:icon && vite build && electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.tecprimus.ccosecuritysuite",
    "productName": "CCO Security Suite",
    "copyright": "Copyright © 2026 TecPrimus Soluções Tecnológicas",
    "electronVersion": "22.3.27",
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "dist-react/**/*",
      "electron/**/*",
      "build/**/*",
      "public/**/*",
      "data/database_template.json",
      "templates/**/*",
      "package.json",
      "!**/*.xlsx",
      "!**/*.csv",
      "!exports/**/*",
      "!MAPA DE CALOR/**/*"
    ],
    "extraResources": [
      {
        "from": "templates",
        "to": "templates"
      },
      {
        "from": "data/database_template.json",
        "to": "data/database_template.json"
      }
    ],
    "win": {
      "icon": "public/shield.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName} Setup ${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "CCO Security Suite",
      "uninstallDisplayName": "CCO Security Suite",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "public/shield.ico",
      "uninstallerIcon": "public/shield.ico",
      "license": "build/termos_licenca.txt",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "marked": "^18.0.12",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0",
    "wait-on": "^9.1.0"
  }
}
